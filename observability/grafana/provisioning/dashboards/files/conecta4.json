      "type": "stat",
      "title": "Partidas creadas",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "#38bdf8" } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "loki", "uid": "loki" }, "editorMode": "code", "expr": "sum(count_over_time({app=\"conecta4\", event=\"partida_creada\"}[$__range]))", "queryType": "instant", "refId": "A" }]
